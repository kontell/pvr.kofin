<?xml version="1.0" encoding="UTF-8"?>
<!-- Commercial skip overlay: Skip Ad / Close. The same window as Kofin's
     segment overlay (script-kofin-skip.xml) without the Play Next button.
     Buttons show when their window property is non-empty; stock textures
     only (colordiffused white.png), no addon-branded art. -->
<window>
	<defaultcontrol always="true">3010</defaultcontrol>
	<onload>Dialog.Close(fullscreeninfo,true)</onload>
	<controls>
		<control type="group">
			<!-- Slide in from the right, bottom-right anchored -->
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="300" />
				<effect type="slide" start="400,0" end="0,0" time="300" tween="cubic" easing="out"/>
			</animation>
			<animation type="WindowClose" reversible="false">
				<effect type="fade" start="100" end="0" time="300" />
				<effect type="slide" start="0,0" end="400,0" time="300" tween="cubic" easing="in"/>
			</animation>
			<left>1120</left>
			<top>896</top>
			<control type="group">
				<width>760</width>
				<height>122</height>
				<!-- The buttons carry their own backgrounds and the grouplist
				     right-aligns content narrower than itself, so the row hugs
				     the right edge whatever its width. -->
				<control type="grouplist" id="3010">
					<left>0</left>
					<top>52</top>
					<width>760</width>
					<height>56</height>
					<orientation>horizontal</orientation>
					<align>right</align>
					<itemgap>10</itemgap>
					<!-- Accent bar: inside the list so it tracks the row -->
					<control type="image">
						<width>4</width>
						<height>56</height>
						<texture colordiffuse="FF00A4DC">white.png</texture>
					</control>
					<control type="button" id="3012">
						<visible>!String.IsEmpty(Window.Property(pvrkofin.skip.label))</visible>
						<label>$INFO[Window.Property(pvrkofin.skip.label)]$INFO[Window.Property(pvrkofin.skip.duration), (,)]</label>
						<height>56</height>
						<width min="200">auto</width>
						<font>font13</font>
						<textoffsetx>20</textoffsetx>
						<textcolor>FFFFFFFF</textcolor>
						<focusedcolor>FF000000</focusedcolor>
						<shadowcolor>66000000</shadowcolor>
						<aligny>center</aligny>
						<align>center</align>
						<texturefocus colordiffuse="FF00A4DC">white.png</texturefocus>
						<texturenofocus colordiffuse="D9000000">white.png</texturenofocus>
						<pulseonselect>no</pulseonselect>
					</control>
					<control type="button" id="3013">
						<label>$INFO[Window.Property(pvrkofin.close.label)]</label>
						<height>56</height>
						<width min="120">auto</width>
						<font>font13</font>
						<textoffsetx>15</textoffsetx>
						<textcolor>FFFFFFFF</textcolor>
						<focusedcolor>FF000000</focusedcolor>
						<shadowcolor>66000000</shadowcolor>
						<aligny>center</aligny>
						<align>center</align>
						<texturefocus colordiffuse="FF00A4DC">white.png</texturefocus>
						<texturenofocus colordiffuse="D9000000">white.png</texturenofocus>
						<pulseonselect>no</pulseonselect>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>
