# build artifacts
build/
build-*/
pvr.*/addon.xml

# Debian build files
debian/changelog
debian/files
debian/*.log
debian/*.substvars
debian/.debhelper/
debian/tmp/
debian/kodi-pvr-*/
obj-x86_64-linux-gnu/

# commonly used editors
# vim
*.swp

# Eclipse
*.project
*.cproject
.classpath
*.sublime-*
.settings/

# KDevelop 4
*.kdev4

# gedit
*~

# CLion
/.idea

# clion
.idea/

# to prevent add after a "git format-patch VALUE" and "git add ." call
/*.patch

# Visual Studio Code
.vscode

# to prevent add if project code opened by Visual Studio over CMake file
.vs/

# General MacOS
.DS_Store
.AppleDouble
.LSOverride

# Editor/merge temp copies of CLAUDE.md, like CLAUDE.md.tmp.*. CLAUDE.md
# itself is tracked; it imports AGENTS.md.
CLAUDE.md.*

# Local-only utility scripts
scripts/release-downloads.sh

# Byte-compiled Python. service.py and the i18n scripts are run in place, so a
# stray __pycache__ under resources/ would otherwise be packaged into the zip.
__pycache__/
*.py[cod]
